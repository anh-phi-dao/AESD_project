# Add configuration entries here only when a component consumes them.
# Solenoid, auto-lock timeout, and audio settings are deferred until their implementations exist.

menu "PCF8574 driver configuration"

config PCF8574_DEFAULT_SDA_PIN
    int "Default SDA GPIO"
    default 15
    help
        GPIO used as the default I2C SDA line when the configuration leaves it unspecified.

config PCF8574_DEFAULT_SCL_PIN
    int "Default SCL GPIO"
    default 7
    help
        GPIO used as the default I2C SCL line when the configuration leaves it unspecified.

config PCF8574_DEFAULT_INT_PIN
    int "Default interrupt GPIO"
    default 6
    help
        GPIO used as the default PCF8574 interrupt input.

config PCF8574_DEFAULT_I2C_ADDR
    hex "Default I2C address"
    default 0x20
    help
        Seven-bit I2C address used by the default PCF8574 configuration.

config PCF8574_DEFAULT_CLK_SPEED_HZ
    int "Default I2C clock speed (Hz)"
    default 100000
    help
        I2C clock speed used by the default PCF8574 configuration.

endmenu

menu "Door simulator (dev board)"

config DOOR_SIM_ENABLE
    bool "Simulate lock activity without keypad, NFC or sensors"
    default y
    help
        Creates access events and alerts from the BOOT button and the "sim" serial console command, through the
        same event log the real lock logic will use, so MQTT and the web page can be tested on a bare ESP32-S3.
        Nothing from the network can trigger it. Disable on the product board.

config DOOR_SIM_BUTTON_GPIO
    int "Simulator button GPIO (active low)"
    depends on DOOR_SIM_ENABLE
    default 0
    help
        GPIO0 is the BOOT button of ESP32-S3 dev boards. Short press: access attempt. Hold 1 s: tamper alert.

endmenu
